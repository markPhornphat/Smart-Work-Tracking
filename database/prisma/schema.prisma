generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CustomFieldType {
  TEXT
  NUMBER
  CURRENCY
  DATE
  DATE_RANGE
  CHECKBOX
  DROPDOWN
  MULTI_SELECT
  USER
  URL
  EMAIL
  PHONE
  RATING
}

enum ProjectViewType {
  BACKLOG
  KANBAN
  LIST
  CALENDAR
  TIMELINE
  TABLE
  DASHBOARD
}

enum DependencyType {
  BLOCKS
  IS_BLOCKED_BY
  RELATES_TO
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  COMMENTED
  STATUS_CHANGED
  ASSIGNED
  ATTACHED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  memberships          OrganizationMember[]
  assignedTasks        Task[]               @relation("TaskAssignee")
  reportedTasks        Task[]               @relation("TaskReporter")
  watchedTasks         TaskWatcher[]
  comments             Comment[]
  activities           ActivityHistory[]
  notifications        Notification[]
  roles                UserRole[]
  customFieldValues    CustomFieldValue[]   @relation("CustomFieldUserValue")
  refreshTokens        RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspaces Workspace[]
  members    OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Workspace {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@map("workspaces")
}

model ProjectTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  key                String   @unique
  name               String
  description        String?
  department         String?
  recommendedViews   Json     @default("[]")
  defaultSections    Json     @default("[]")
  suggestedTags      Json     @default("[]")
  defaultCustomFields Json    @default("[]")
  workflowStatuses   Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  projects Project[]

  @@map("project_templates")
}

model Project {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  templateId   String?   @db.Uuid
  name         String
  key          String
  description  String?
  isFavorite   Boolean   @default(false)
  isArchived   Boolean   @default(false)
  lastViewType ProjectViewType @default(BACKLOG)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template   ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  workflow   Workflow?
  sections   Section[]
  tasks      Task[]
  tags       Tag[]
  customFields CustomField[]

  @@unique([workspaceId, key])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, isArchived])
  @@map("projects")
}

model Workflow {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @unique @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statuses WorkflowStatus[]

  @@map("workflows")
}

model WorkflowStatus {
  id          String    @id @default(uuid()) @db.Uuid
  workflowId  String    @db.Uuid
  name        String
  color       String    @default("#6B7280")
  sortOrder   Int       @default(0)
  isDone      Boolean   @default(false)
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([workflowId, sortOrder])
  @@index([workflowId, deletedAt])
  @@map("workflow_statuses")
}

model Section {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  name       String
  sortOrder  Int       @default(0)
  isCollapsed Boolean  @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, sortOrder])
  @@index([projectId, deletedAt])
  @@map("sections")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  name      String
  color     String    @default("#3B82F6")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskTag[]

  @@unique([projectId, name])
  @@index([projectId, deletedAt])
  @@map("tags")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  projectId      String       @db.Uuid
  sectionId      String?      @db.Uuid
  statusId       String?      @db.Uuid
  parentTaskId   String?      @db.Uuid
  title          String
  description    String?
  priority       TaskPriority @default(NONE)
  assigneeId     String?      @db.Uuid
  reporterId     String?      @db.Uuid
  dueDate        DateTime?
  startDate      DateTime?
  estimatedHours Decimal?     @db.Decimal(10, 2)
  actualHours    Decimal?     @db.Decimal(10, 2)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section    Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  status     WorkflowStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  parent     Task?           @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children   Task[]          @relation("TaskHierarchy")
  assignee   User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter   User?           @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  tags       TaskTag[]
  comments   Comment[]
  attachments Attachment[]
  activities ActivityHistory[]
  watchers   TaskWatcher[]
  customFieldValues CustomFieldValue[]
  dependenciesFrom TaskDependency[] @relation("DependencyFrom")
  dependenciesTo   TaskDependency[] @relation("DependencyTo")

  @@index([projectId, deletedAt])
  @@index([projectId, statusId])
  @@index([projectId, sectionId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskTag {
  taskId String @db.Uuid
  tagId  String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model TaskWatcher {
  taskId String @db.Uuid
  userId String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_watchers")
}

model TaskDependency {
  id           String         @id @default(uuid()) @db.Uuid
  fromTaskId   String         @db.Uuid
  toTaskId     String         @db.Uuid
  type         DependencyType @default(BLOCKS)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  fromTask Task @relation("DependencyFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("DependencyTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId, type])
  @@index([toTaskId])
  @@map("task_dependencies")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @db.Uuid
  authorId  String?   @db.Uuid
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("comments")
}

model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  taskId       String    @db.Uuid
  fileName     String
  contentType  String?
  sizeBytes    Int?
  storageKey   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("attachments")
}

model ActivityHistory {
  id         String         @id @default(uuid()) @db.Uuid
  taskId     String?        @db.Uuid
  actorId    String?        @db.Uuid
  action     ActivityAction
  entityType String
  entityId   String?        @db.Uuid
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_history")
}

model CustomField {
  id         String          @id @default(uuid()) @db.Uuid
  projectId  String          @db.Uuid
  name       String
  key        String
  type       CustomFieldType
  options    Json            @default("[]")
  isRequired Boolean         @default(false)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@unique([projectId, key])
  @@index([projectId, deletedAt])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String    @id @default(uuid()) @db.Uuid
  customFieldId String    @db.Uuid
  taskId        String    @db.Uuid
  valueText     String?
  valueNumber   Decimal?  @db.Decimal(18, 4)
  valueBoolean  Boolean?
  valueDate     DateTime?
  valueDateEnd  DateTime?
  valueJson     Json?
  userId        String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User?       @relation("CustomFieldUserValue", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([customFieldId, taskId])
  @@index([taskId])
  @@map("custom_field_values")
}

/// Placeholder for future notifications
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String
  body      String?
  isRead    Boolean   @default(false)
  payload   Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
