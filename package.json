{
  "name": "smart-work-tracking",
  "private": true,
  "version": "1.0.0",
  "description": "Smart-Work-Tracking monorepo (backend API + frontend)",
  "scripts": {
    "dev:backend": "npm run dev:server --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend",
    "test:backend": "npm test --prefix backend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm start --prefix backend"
  },
  "engines": {
    "node": ">=20"
  }
}
